# ~/conf-tracker/.env on the box. Never in git. Both values: openssl rand -hex 32
PG_PASSWORD=CHANGE_ME
# The frontend (Vercel) sends this as its bearer token; set the same value there.
API_SHARED_SECRET=CHANGE_ME
LOG_LEVEL=info
# The password of the dashboard the box serves on 127.0.0.1:3094 (deploy/README.md). Any long string.
ACCESS_PASSWORD=CHANGE_ME
