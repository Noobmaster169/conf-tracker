# Copy to .env. Never commit .env.
PORT=8092
PG_HOST=127.0.0.1
PG_PORT=5434
PG_DATABASE=yt_stream
PG_USER=postgres
PG_PASSWORD=localdev
# The speech service: on the box, tunnelled to this machine (see speech/README.md).
SPEECH_URL=ws://127.0.0.1:8100/sessions
# Bearer token the frontend sends. Generate: openssl rand -hex 32
API_SHARED_SECRET=CHANGE_ME
LOG_LEVEL=info
# The llm-proxy of compose.local.yaml. Inside the box's compose it is http://llm-proxy:4000.
LLM_PROXY_URL=http://127.0.0.1:4002
# The proxy's Claude Code login, read by compose. Make one with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
